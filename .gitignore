# Project source volumes
volumes-projects/nginx/*
!volumes-projects/nginx/.gitkeep
!volumes-projects/nginx/phpinfo.php
volumes-projects/apache/*
!volumes-projects/apache/.gitkeep
!volumes-projects/apache/phpinfo.php

# Data volumes
volumes-data/mysql/*
!volumes-data/mysql/.gitkeep
volumes-data/postgresql/*
!volumes-data/postgresql/.gitkeep
volumes-data/redis/*
!volumes-data/redis/.gitkeep

.env
