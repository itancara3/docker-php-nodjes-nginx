# Docker platform (Apple Silicon default)
DOCKER_PLATFORM=linux/arm64/v8

# Select PHP subfolder from docker/php/<version>
PHP_VERSION=8.4

# Active web stack for Dev Container workspace mount (nginx|apache)
WEB_SERVER=nginx
# Subfolder inside volumes-projects/<WEB_SERVER> for workspace mount (use . for root)
WEB_PROJECT_DIR=.

# Optional build switches
INSTALL_XDEBUG=true
INSTALL_BROWSER_TOOLS=true
INSTALL_PUPPETEER=true

# Ports
NGINX_PORT=80
APACHE_PORT=8080
MYSQL_PORT=3306
POSTGRES_PORT=5432
REDIS_PORT=6379
XDEBUG_PORT=9003

# Passwords
MYSQL_ROOT_PASSWORD=root
MYSQL_ALLOW_EMPTY_PASSWORD=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
REDIS_PASSWORD=redis
