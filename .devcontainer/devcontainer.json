{
  "name": "PHP Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "php",
  "workspaceFolder": "/usr/share/nginx/html/core4-back",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly"
  ],
  "containerEnv": {
    "LD_PRELOAD": "/usr/lib/faketime/libfaketime.so.1"
  },
  "remoteEnv": {
    "GIT_SSH_COMMAND": "ssh -i /root/.ssh/id_ed25519 -o StrictHostKeyChecking=no"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "felixfbecker.php-intellisense",
        "open-southeners.laravel-pint",
        "amiralizadeh9480.laravel-extra-intellisense",
        "xdebug.php-debug",
        "eamodio.gitlens",
        "Codeium.codeium",
        "Vue.volar"
      ],
      "settings": {
        "git.path": "/usr/bin/git",
        "php.validate.executablePath": "/usr/local/bin/php",
        // Enable the extension we installed
        "laravel-pint.enable": true,
        // Define the new formatting extension as the default
        // formatter for all PHP files
        "[php]": {
          "editor.defaultFormatter": "open-southeners.laravel-pint"
        },
        // Enable VsCode Format on Save
        "editor.formatOnSave": true,
        "editor.rulers": [
          {
            "column": 120,
            "color": "#FF6D00"
          },
          {
            "column": 150,
            "color": "#D50000"
          }
        ]
      }
    }
  },
  "postAttachCommand": []
}